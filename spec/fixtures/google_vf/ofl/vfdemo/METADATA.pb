name: "Vf Demo"
designer: "Test"
license: "OFL"
category: "SANS_SERIF"
date_added: "2020-01-01"
fonts {
  name: "Vf Demo"
  style: "normal"
  weight: 400
  filename: "VfDemo[wdth,wght].ttf"
  post_script_name: "VfDemo-Regular"
  full_name: "Vf Demo Regular"
  copyright: "Copyright 2020 The Vf Demo Project Authors"
}
fonts {
  name: "Vf Demo"
  style: "italic"
  weight: 400
  filename: "VfDemo-Italic[wght].ttf"
  post_script_name: "VfDemo-Italic"
  full_name: "Vf Demo Italic"
  copyright: "Copyright 2020 The Vf Demo Project Authors"
}
subsets: "latin"
axes {
  tag: "wdth"
  min_value: 75.0
  max_value: 100.0
}
axes {
  tag: "wght"
  min_value: 100.0
  max_value: 900.0
  default_value: 400.0
}
